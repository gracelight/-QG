 398   2      
 399   2              for(col=0; col<3; col++) {
 400   3                  u8 col_val = 1;
 401   3                  switch(col) {
 402   4                      case 0: col_val = KEY_COL0; break;
 403   4                      case 1: col_val = KEY_COL1; break;
 404   4                      case 2: col_val = KEY_COL2; break;
 405   4                  }
 406   3                  if(col_val == 0) {
 407   4                      delay_ms(20);
 408   4                      if(col_val == 0) {
 409   5                          key_value = key_map[row][col];
 410   5                          while(col_val == 0) {
 411   6                              switch(col) {
 412   7                                  case 0: col_val = KEY_COL0; break;
 413   7                                  case 1: col_val = KEY_COL1; break;
 414   7                                  case 2: col_val = KEY_COL2; break;
 415   7                              }
 416   6                          }
 417   5                          return; // 必须return，否则按键失灵
 418   5                      }
 419   4                  }
 420   3              }
 421   2          }
