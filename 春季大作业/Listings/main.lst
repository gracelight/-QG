 320          void lcd_init(void) {
 321   1          LCD_CS1 = 1;
 322   1          LCD_CS2 = 0;
 323   1          LCD_RS = 0;
 324   1          LCD_RW = 0;
 325   1          LCD_E = 0;
 326   1          delay_ms(50);
 327   1      
 328   1          lcd_select_screen(2);
 329   1          lcd_write_cmd(0xC0);  // 设置显示起始行
 330   1          lcd_write_cmd(0x3F);  // 开显示
 331   1          lcd_clear();
 332   1      }
 333          
 334          void lcd_set_pos(u8 x, u8 y) {
 335   1          u8 col = x * 8;
 336   1          if(col < 64) {
 337   2              lcd_select_screen(0);
 338   2          } else {
 339   2              lcd_select_screen(1);
 340   2              col -= 64;
 341   2          }
 342   1          lcd_write_cmd(0xB8 | y);
 343   1          lcd_write_cmd(0x40 | col);
 344   1      }
 345          
 346          void lcd_clear(void) {
 347   1          u8 i, j;
 348   1          lcd_select_screen(2);
 349   1          for(i=0; i<8; i++) {
 350   2              lcd_write_cmd(0xB8 | i);
 351   2              lcd_write_cmd(0x40);
 352   2              for(j=0; j<64; j++) {
 353   3                  lcd_write_data(0x00);
 354   3              }
 355   2          }
 356   1      }
 357          
 358          void lcd_show_char(u8 x, u8 y, u8 c) {
 359   1          u8 i, idx = 0;
 360   1          if(c >= '0' && c <= '9') idx = c - '0' + 8;
 361   1          else if(c >= 'A' && c <= 'Z') idx = c - 'A' + 18;
 362   1          else {
 363   2              switch(c) {
 364   3                  case 'O': idx=1; break; case 'X': idx=2; break; case '-': idx=3; break;
C51 COMPILER V9.54   MAIN                                                                  04/16/2026 12:53:26 PAGE 7   

 365   3                  case '=': idx=4; break; case '#': idx=5; break; case '*': idx=6; break;
 366   3                  case '.': idx=7; break; case '>': idx=44; break; case ':': idx=43; break;
 367   3                  default: idx=0; break;
 368   3              }
 369   2          }
 370   1      
 371   1          lcd_set_pos(x, y);
 372   1          for(i=0; i<8; i++) lcd_write_data(char_table[idx][i]);
 373   1          lcd_set_pos(x, y+1);
 374   1          for(i=8; i<16; i++) lcd_write_data(char_table[idx][i]);
 375   1      }
 376          
 377          void lcd_show_str(u8 x, u8 y, u8 *str) {
 378   1          while(*str && x<16) {
 379   2              lcd_show_char(x++, y, *str++);
 380   2          }
 381   1      }
