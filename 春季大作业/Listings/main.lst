 264          /******************** 基础延时函数 ********************/
 265          void delay_ms(u16 ms) {
 266   1          u16 i, j;
 267   1          for(i = 0; i < ms; i++)
 268   1              for(j = 0; j < 114; j++);
 269   1      }
 270          
 271          void delay_10us(u8 t) {
 272   1          while(t--) _nop_();
 273   1      }
