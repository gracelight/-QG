 275          /****************===== 核心修复1：正确的AMPIRE128X64驱动 =====****************/
 276          void lcd_select_screen(u8 screen)
 277          {
 278   1          if(screen == 0) {
 279   2              LCD_CS1 = 0; // 左半屏：低电平有效
 280   2              LCD_CS2 = 1; // 右半屏关闭
 281   2          } else if(screen == 1) {
 282   2              LCD_CS1 = 1; // 左半屏关闭
 283   2              LCD_CS2 = 0; // 右半屏：低电平有效
 284   2          } else if(screen == 2) {
 285   2              LCD_CS1 = 0; // 全屏：左右都打开
 286   2              LCD_CS2 = 0;
 287   2          }
 288   1      }
 289          
 290          void lcd_write_cmd(u8 cmd)
 291          {
 292   1          LCD_E  = 0;
 293   1          delay_10us(1);
 294   1          LCD_RS = 0;
 295   1          LCD_RW = 0;
 296   1          delay_10us(1);
 297   1          LCD_DATA = cmd;
 298   1          delay_10us(2);
 299   1          LCD_E = 1;
 300   1          delay_10us(5);
 301   1          LCD_E = 0;
 302   1          delay_10us(2);
C51 COMPILER V9.54   MAIN                                                                  04/16/2026 12:53:26 PAGE 6   

 303   1      }
 304          
 305          void lcd_write_data(u8 dat)
 306          {
 307   1          LCD_E  = 0;
 308   1          delay_10us(1);
 309   1          LCD_RS = 1;
 310   1          LCD_RW = 0;
 311   1          delay_10us(1);
 312   1          LCD_DATA = dat;
 313   1          delay_10us(2);
 314   1          LCD_E = 1;
 315   1          delay_10us(5);
 316   1          LCD_E = 0;
 317   1          delay_10us(2);
 318   1      }
