 128          void main(void) {
 129   1          // 定时器初始化
 130   1          TMOD = 0x21;  // T0工作模式1（16位定时），T1工作模式2
 131   1          // 定时器0初值（10ms）
 132   1          TH0 = (65536 - 10000) / 256;
 133   1          TL0 = (65536 - 10000) % 256;
 134   1          ET0 = 1;      // 使能定时器0中断
 135   1          TR0 = 1;      // 启动定时器0
 136   1          EA  = 1;      // 开启总中断
 137   1          
