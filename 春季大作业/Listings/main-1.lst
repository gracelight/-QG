  75          **********************************************************/
  76          void Menu_Process(void) {
  77   1          u8 key = Key_GetPressed();               // 读取按键值
  78   1          static u8 menuItem = 0;                  // 静态变量：记录当前选中的菜单项
  79   1          
  80   1          if(key == KEY_UP && menuItem > 0)        // 按下上键：选项上移（不越界）
  81   1              menuItem--;
  82   1          if(key == KEY_DOWN && menuItem < 2)      // 按下下键：选项下移（不越界）
  83   1              menuItem++;
  84   1          if(key == KEY_OK) {                      // 按下确认键：执行对应功能
  85   2              switch(menuItem) {
  86   3                  case 0: Game_Init(); break;       // 选中第1项：初始化并开始游戏
  87   3                  case 1: break;                   // 选中第2项：查看最高分（待完善）
  88   3                  case 2: break;                   // 选中第3项：设置难度（待完善）
  89   3              }
  90   2          }
  91   1      }
