  19          /*********************************************************
  20          * 函数名：Timer0_ISR
  21          * 功能  ：定时器0中断服务函数，10ms定时中断
  22          * 输入  ：无
  23          * 输出  ：无
  24          * 备注  ：12MHz晶振，定时10ms，用于系统计时+音效驱动
  25          **********************************************************/
  26          void Timer0_ISR(void) interrupt 1 {
  27   1          // 重装定时器初值，保证10ms精准定时
  28   1          TH0 = (65536 - 10000) / 256;
  29   1          TL0 = (65536 - 10000) % 256;
  30   1          
  31   1          sysTick++;  // 系统节拍+1（每10ms加1）
  32   1          Sound_Tick();  // 蜂鸣器节拍驱动（处理音效播放）
  33   1      }
