 143   1          gameState = GAME_MENU;// 设置初始状态：菜单模式
 144   1          
 145   1          // 主循环：根据游戏状态执行对应逻辑
 146   1          while(1) {
 147   2              switch(gameState) {
 148   3                  case GAME_MENU:     // 菜单状态
 149   3                      Menu_Process();
 150   3                      break;
 151   3                  case GAME_RUNNING:  // 游戏运行状态
 152   3                      Game_Process();
 153   3                      break;
 154   3                  case GAME_PAUSED:   // 游戏暂停状态
 155   3                      Pause_Process();
 156   3                      break;
 157   3                  case GAME_OVER:     // 游戏结束状态
 158   3                      GameOver_Process();
 159   3                      break;
 160   3              }
 161   2          }
 162   1      }


