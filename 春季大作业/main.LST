 435          // ==================== 矩阵键盘扫描 ====================
 436          void key_scan(void)
 437          {
 438   1          u8 row, col;
 439   1          game_key = 0xFF;
 440   1      
 441   1          // 行扫描
 442   1          for(row = 0; row < 4; row++)
 443   1          {
 444   2              P1 = 0x0F;
 445   2              switch(row)
 446   2              {
 447   3                  case 0: KEY_ROW1 = 0; break;
 448   3                  case 1: KEY_ROW2 = 0; break;
 449   3                  case 2: KEY_ROW3 = 0; break;
 450   3                  case 3: KEY_ROW4 = 0; break;
 451   3              }
 452   2              delay_ms(5);
 453   2      
 454   2              // 列检测
 455   2              for(col = 0; col < 3; col++)
 456   2              {
 457   3                  u8 val = 1;
 458   3                  switch(col)
 459   3                  {
 460   4                      case 0: val = KEY_COL1; break;
 461   4                      case 1: val = KEY_COL2; break;
 462   4                      case 2: val = KEY_COL3; break;
 463   4                  }
 464   3                  if(val == 0)
 465   3                  {
 466   4                      delay_ms(20);
 467   4                      if(val == 0)
 468   4                      {
 469   5                          game_key = row * 3 + col;
 470   5                          while(val == 0) {
 471   6                              switch(col){case 0:val=KEY_COL1;break;case 1:val=KEY_COL2;break;case 2:val=KEY_COL
             -3;break;}
 472   6                          }
 473   5                          return;
 474   5                      }
 475   4                  }
 476   3              }
 477   2          }
 478   1      }
