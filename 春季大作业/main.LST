 274          // ==================== 延时函数 ====================
 275          void delay_ms(u16 ms)
 276          {
 277   1          u16 i, j;
 278   1          for(i = 0; i < ms; i++)
 279   1              for(j = 0; j < 110; j++);
 280   1      }
 281          
 282          void delay_10us(u8 t)
 283          {
 284   1          while(t--) _nop_();
 285   1      }
 286          
 287          // ==================== AMPIRE128x64 核心驱动 ====================
 288          void lcd_left(void)  { LCD_CS1 = 0; LCD_CS2 = 1; }
 289          void lcd_right(void) { LCD_CS1 = 1; LCD_CS2 = 0; }
 290          
 291          void lcd_write_cmd(u8 cmd)
 292          {
 293   1          LCD_EN = 0;
 294   1          LCD_RS = 0;
 295   1          LCD_RW = 0;
 296   1          LCD_DATA_PORT = cmd;
 297   1          delay_10us(2);
 298   1          LCD_EN = 1;
 299   1          delay_10us(5);
 300   1          LCD_EN = 0;
 301   1      }
 302          
 303          void lcd_write_data(u8 dat)
C51 COMPILER V9.54   MAIN                                                                  04/16/2026 12:28:23 PAGE 6   

 304          {
 305   1          LCD_EN = 0;
 306   1          LCD_RS = 1;
 307   1          LCD_RW = 0;
 308   1          LCD_DATA_PORT = dat;
 309   1          delay_10us(2);
 310   1          LCD_EN = 1;
 311   1          delay_10us(5);
 312   1          LCD_EN = 0;
 313   1      }
 314          
 315          void lcd_set_pos(u8 x, u8 page)
 316          {
 317   1          if(x < 64) { lcd_left(); }
 318   1          else { lcd_right(); x -= 64; }
 319   1          lcd_write_cmd(0xB8 | page);
 320   1          lcd_write_cmd(0x40 | x);
 321   1      }
 322          
 323          void lcd_clear(void)
 324          {
 325   1          u8 page, col;
 326   1          // 左屏清屏
 327   1          lcd_left();
 328   1          for(page = 0; page < 8; page++)
 329   1          {
 330   2              lcd_write_cmd(0xB8 | page);
 331   2              lcd_write_cmd(0x40);
 332   2              for(col = 0; col < 64; col++)
 333   2                  lcd_write_data(0x00);
 334   2          }
 335   1          // 右屏清屏
 336   1          lcd_right();
 337   1          for(page = 0; page < 8; page++)
 338   1          {
 339   2              lcd_write_cmd(0xB8 | page);
 340   2              lcd_write_cmd(0x40);
 341   2              for(col = 0; col < 64; col++)
 342   2                  lcd_write_data(0x00);
 343   2          }
 344   1      }
 345          
 346          void lcd_init(void)
 347          {
 348   1          LCD_CS1 = 1;
 349   1          LCD_CS2 = 1;
 350   1          delay_ms(50);
 351   1      
 352   1          // 左屏初始化
 353   1          lcd_left();
 354   1          lcd_write_cmd(0x3E);
 355   1          lcd_write_cmd(0xC0);
 356   1          lcd_write_cmd(0x3F);
 357   1      
 358   1          // 右屏初始化
 359   1          lcd_right();
 360   1          lcd_write_cmd(0x3E);
 361   1          lcd_write_cmd(0xC0);
 362   1          lcd_write_cmd(0x3F);
 363   1      
 364   1          lcd_clear();
 365   1      }
