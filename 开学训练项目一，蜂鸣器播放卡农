void Play_Note(u16 note)
{
  u8 pitch,len,num;    //¶¨Òå
  u16 Current_Freq;
  
  if(note==0)
	{
		TR0=0;
		Delay_ms(400);
		return;
	}                          //Í£Ö¹·û
  pitch=note /100;           //°ÙÎ»ÎªÒô¸ß
  len=(note/10)%10;          //Ê®Î»Îª½ÚÅÄ
  num=note%10;               //¸öÎ»ÎªÒô·û1~7
  Current_Freq=tone_table[(pitch-1)*7+(num-1)];//»ñÈ¡ÆµÂÊ
  TH0=Current_Freq/256;
  TL0=Current_Freq%256;
  TR0=1;                    //Æô¶¯·¢Éù
	 //¶¨Òå½ÚÅÄ
  switch(len)
  {
    case 1: Delay_ms(400); break;  //1/4ÅÄ
    case 2: Delay_ms(800); break;  //1/2ÅÄ
    case 3: Delay_ms(1600); break;  //1ÅÄ
    default: Delay_ms(400);

  }
  TR0 = 0;
  BEEP = 0;
  Delay_ms(50);              //½áÊø·¢Éù
}

